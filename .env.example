# Get credentials from https://my.telegram.org/apps and https://t.me/BotFather
API_ID=
API_HASH=
BOT_TOKEN=

# Large files use File2Share numbered parts. Telegram's own limits also apply.
TRANSFER_URL=https://file2share.us
MAX_FILE_SIZE=2000000000
MAX_CONCURRENT_TRANSFERS=3
TRANSFER_TIMEOUT=1800

# Empty allows all users. Set your numeric Telegram ID for a private bot.
ALLOWED_USER_IDS=
SESSION_PATH=data/uploadbot

# Optional JSON profiles for put, file2share or webdav providers. See docs/setup.md.
UPLOAD_PROVIDERS=[]
